########################################
# Initialization
########################################

exec dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

########################################
# Startup Programs
########################################

exec "noctalia"
exec "~/.config/waypaper/init.sh"

########################################
# Appearance
########################################

# gaps inner 20
gaps inner 20
gaps outer 0

font monospace 1
titlebar_border_thickness 0
titlebar_padding 0

client.focused          #FAC000 #FF7500 #FF7500 #FAC000
client.unfocused        #333333 #801100 #801100
client.focused_inactive #333333 #801100 #801100

########################################
# Misc
########################################

input type:touchpad {
    tap enabled
    tap_button_map lrm
    natural_scroll disabled
    scroll_method two_finger
    dwt enabled
}

########################################
# Bindings
########################################

set $mod Mod4

set $left h
set $down j
set $up k
set $right l

bindsym $mod+Return exec kitty
bindsym $mod+Space exec "noctalia msg panel-toggle launcher"
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+s exec "noctalia msg panel-toggle session"

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6

bindsym $mod+b splith
bindsym $mod+v splitv

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+f fullscreen
bindsym $mod+Shift+f floating toggle
floating_modifier $mod normal
bindsym $mod+Shift+space focus mode_toggle
bindsym $mod+p focus parent
bindsym $mod+n focus child

mode "resize" {
    bindsym $left resize shrink width
    bindsym $down resize grow height
    bindsym $up resize shrink height
    bindsym $right resize grow width

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

bindsym --locked XF86AudioMute exec "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
bindsym --locked XF86AudioLowerVolume exec "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"
bindsym --locked XF86AudioRaiseVolume exec "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+"

bindsym Print exec "flameshot screen"
