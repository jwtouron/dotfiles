# -*- mode:shell-script -*-

alias wl='wc -l'

alias ls='ls --color=auto'
alias ll='ls -lavF'   # show long listing of all except ".."
alias la='ls -AF'
alias l='ls -lavF'   # show long listing but no hidden dotfiles except "."
alias lt='ls -lAFt'
alias ltr='ls -lAFtr'

alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

alias config='/usr/bin/git --git-dir=$HOME/.config/.dotfiles/ --work-tree=$HOME'
alias config-sync='GIT_DIR=$HOME/.config/.dotfiles GIT_WORK_TREE=$HOME git-sync'

# Nix
alias nix-install='nix-env -iA'  # packagename
alias nix-query='nix-env -q'
alias nix-search='nix search nixpkgs'  # packagename
alias nix-uninstall='nix-env -e'  # packagename
alias nix-upgrade='nix-env -u'

command -v fdfind > /dev/null && alias fd='fdfind'
command -v batcat >/dev/null && alias bat='batcat'
command -v bat >/dev/null && export PAGER='bat'

source ~/.config/fzf/aliases
source ~/.config/fzf/functions

source ~/.config/shell/man

 # vim: ft=sh:
