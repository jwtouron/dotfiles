-- If LuaRocks is installed, make sure that packages installed through it are
-- found (e.g. lgi). If LuaRocks is not installed, do nothing.
pcall(require, "luarocks.loader")

-- Standard awesome library
local gears = require("gears")
local awful = require("awful")
require("awful.autofocus")
-- Widget and layout library
local wibox = require("wibox")
-- Theme handling library
local beautiful = require("beautiful")
-- Notification library
local naughty = require("naughty")
local sharedtags = require("sharedtags")
local wibar = require("wibar")

-- {{{ Error handling
-- Check if awesome encountered an error during startup and fell back to
-- another config (This code will only ever execute for the fallback config)
if awesome.startup_errors then
    naughty.notify({ preset = naughty.config.presets.critical,
                     title = "Oops, there were errors during startup!",
                     text = awesome.startup_errors })
end

-- Handle runtime errors after startup
do
    local in_error = false
    awesome.connect_signal("debug::error", function (err)
        -- Make sure we don't go into an endless error loop
        if in_error then return end
        in_error = true

        naughty.notify({ preset = naughty.config.presets.critical,
                         title = "Oops, an error happened!",
                         text = tostring(err) })
        in_error = false
    end)
end
-- }}}

-- {{{ Variable definitions
-- Themes define colours, icons, font and wallpapers.
beautiful.init(gears.filesystem.get_themes_dir() .. "default/theme.lua")
beautiful.border_width = 2

-- Returns the path of program, or nil if cannot be found.
local function get_path(program)
    local path = os.getenv("PATH")
    for dir in string.gmatch(os.getenv("PATH"), "[^:]+") do
        local full_path = dir .. "/" .. program
        if gears.filesystem.file_executable(full_path) then
            return full_path
        end
    end
    return nil
end

-- Returns the program whose path is first found or nil, if none can be found.
local function find_one_of(programs)
    for i = 1, #programs do
        if get_path(programs[i]) then
            return programs[i]
        end
    end
    return nil
end

-- Global values
local terminal = find_one_of({"kitty", "st-tabbed", "termite", "xterm"})
local browser = find_one_of({"brave", "brave-browser", "firefox"})
local editor = os.getenv("EDITOR") or "vim"
local editor_cmd = terminal .. " -e " .. editor
local modkey = "Mod4"

