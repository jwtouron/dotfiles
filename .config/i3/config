floating_modifier Mod4
tiling_drag modifier titlebar

# Appearance
default_border pixel 2
default_floating_border pixel 2
smart_borders on

gaps inner 10
gaps outer 10
gaps top 35

# Rules
for_window [class="Lxappearance"] floating enable
for_window [class="pavucontrol"] floating enable resize set 800 600, move to workspace number 6
for_window [class="WeatherPopup"] floating enable, move position center
for_window [class="Yad"] floating  enable

include conf/*.conf

