separator_block_width=25

[volume-pulseaudio]
command=scripts/volume-pulseaudio
interval=once
signal=1
LONG_FORMAT="${SYMB} ${VOL}%"
SHORT_FORMAT="${SYMB} ${VOL}%"
DEFAULT_COLOR="#888888"
MUTED_COLOR="#666666"

[cpu]
command=scripts/cpumem
markup=pango
interval=1
color=#888888

[weather]
command=~/.local/bin/weather-simple.sh; case $button in 1) xterm -class xterm-floating -geometry 80x40 -e '~/.local/bin/weather-detailed.sh | less' ;; esac
interval=1800
color=#888888

[time]
command=scripts/date
interval=5
color=#888888
