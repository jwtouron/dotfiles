[volume]
command=~/.config/i3blocks/volume.sh
interval=once
signal=10

[cpu]
command=~/.config/i3blocks/cpu.sh
interval=1
markup=pango

[memory]
command=~/.config/i3blocks/memory.sh
interval=1
markup=pango

[updates]
command=~/.config/i3blocks/updates.sh
interval=3600

[weather]
command=~/.config/i3blocks/weather.sh
interval=3600

[datetime]
command=~/.config/i3blocks/datetime.sh
interval=5

[powermenu]
full_text=   |
command=~/.config/i3/powermenu.sh
