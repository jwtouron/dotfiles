! st
st*.font: \n\
    DejaVu Sans Mono:style=Book:pixelsize=14:antialias=true:autohint=true \n\
    mono:pixelsize=14:antialias=true:autohint=true

! URxvt
URxvt.font: xft:DejaVu Sans Mono:style=Book:size=11, xft:Symbola:size=11, xft:mono:size=11
URxvt.letterSpace: -1
URxvt.perl-ext-common: tabbed,resize-font
URxvt.scrollBar: false

! XTerm
XTerm.vt100.faceName: DejaVu Sans Mono:style=Book \n\
                      mono
XTerm.vt100.faceSize: 11
XTerm.termName: xterm-256color
XTerm.vt100.metaSendsEscape: true
XTerm.vt100.backarrowKey: false
XTerm.ttyModes: erase ^?

XTerm.vt100.translations: #override \n\
    Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>V: insert-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>Up: scroll-back(1, line) \n\
    Ctrl Shift <Key>Down: scroll-forw(1, line)

! xterm-floating
xterm-floating.vt100.faceName: DejaVu Sans Mono:style=Book \n\
                               mono
xterm-floating.vt100.faceSize: 11
xterm-floating.termName: xterm-256color

#include ".config/x11/colors"
