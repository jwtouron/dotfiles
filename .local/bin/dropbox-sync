#!/usr/bin/env bash

set -euxo pipefail

if ! command -v rclone >/dev/null; then
    echo ERROR: rclone not found
    exit 1
fi

if ! rclone config show | grep -q '\[dropbox\]'; then
    rclone config create dropbox dropbox
fi

rclone bisync ~/Documents/Notes dropbox:Notes --verbose "$@"

# vim: set ft=bash
