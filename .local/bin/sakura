#!/bin/sh

SKEL_FILE=~/.config/sakura/sakura.skel
CUSTOM_FILE=~/.config/sakura/custom.conf

# Create conf from skel and custom
[ ! -f "$CUSTOM_FILE" ] && touch "$CUSTOM_FILE"
cat "$SKEL_FILE" "$CUSTOM_FILE" > ~/.config/sakura/sakura.conf

# cp -p "$SKEL_FILE" \
#    ~/.config/sakura/sakura.conf

if test $# -gt 0; then
   exec /usr/bin/sakura --colorset $1
else
   exec /usr/bin/sakura
fi

# vim: set ts=4:
