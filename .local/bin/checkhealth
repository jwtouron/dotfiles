#!/usr/bin/env bash

set -eo pipefail

red="\e[31m"
green="\e[32m"
blue="\e[34m"
clear="\e[0m"

header() {
    echo -e "${blue}### Checking $* ###${clear}"
    echo ""
}

check_for_all() {
    echo Checking for all of: "$@"
    local missing=""
    for arg in "$@"; do
        if ! command -v "$arg" > /dev/null; then
            if test -n "$missing"; then
                missing="$missing $arg"
            else
                missing="$arg"
            fi
        fi
    done
    if test -n "$missing"; then
        echo -e "${red}Missing:${clear} $missing"
    else
        echo -e "${green}All Installed!${clear}"
    fi
    echo ""
}

check_for_one() {
    echo Checking for one of: "$@"
    local found=""
    for arg in "$@"; do
        if command -v "$arg" >/dev/null; then
            found="$arg $found"
        fi
    done
    if test -n "$found"; then
        echo -e "${green}Found:${clear} $found"
    else
        echo -e "${red}None found!${clear}"
    fi
    echo ""
}

commandline_utilities() {
    header "Commandline Utilities"
    check_for_all 7z bat fd fzf htop lsd rg tmux
}

environment_variables() {
    header Environment Variables
    local var_names=("BROWSER" "TERMINAL")
    for var_name in "${var_names[@]}"; do
        if test -n "${!var_name}"; then
            local installed
            if command -v "${!var_name}" > /dev/null; then
                installed="${green}installed${clear}"
            else
                installed="${red}not installed${clear}"
            fi
            echo -e "[${green}SET${clear}]   \$$var_name (${!var_name}, $installed)"
        else
            echo -e "[${red}UNSET${clear}] \$$var_name"
        fi
    done
    echo ""
}

miscellaneous() {
    header "Miscellaneous Programs"
    check_for_all nvim zsh
    if command -v fc-list > /dev/null; then
        if fc-list | grep -i nerd > /dev/null; then
            echo -e "${green}Nerd font installed!${clear}"
        else
            echo -e "${red}MISSING:${clear} Nerd font NOT installed!"
        fi
    else
        echo -e "${red}ERROR:${clear} Can't check for nerd fonts: fc-list not installed"
    fi
    echo ""
}

terminals() {
    header Terminals
    check_for_all xterm
    check_for_one kitty wezterm st
}

tiling_window_manager() {
    # TODO: dex?
    header "Tiling Window Manager Dependencies"
    check_for_all cbatticon jq loginctl lxappearance nm-applet notify-send pavucontrol pcmanfm picom scrot xclip xsel xss-lock xwallpaper yad
    check_for_one i3lock-fancy i3lock xlock
    check_for_one parcellite xfce4-clipman
    check_for_one amixer pactl
}

environment_variables
commandline_utilities
terminals
tiling_window_manager
miscellaneous

# vim: set filetype=bash :
